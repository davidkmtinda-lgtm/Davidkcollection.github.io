<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Davidk Collection | Quality Shoes</title>

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f4f4;
            color: #222;
            line-height: 1.6;
        }

        /* HEADER */

        header {
            background: #111;
            color: white;
            text-align: center;
            padding: 30px 15px;
        }

        header h1 {
            font-size: 35px;
            margin-bottom: 8px;
        }

        header p {
            font-size: 17px;
        }

        /* NAVIGATION */

        nav {
            background: #222;
            text-align: center;
            padding: 12px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 10px;
            font-weight: bold;
        }

        /* HERO */

        .hero {
            background: white;
            text-align: center;
            padding: 45px 20px;
        }

        .hero h2 {
            font-size: 30px;
            margin-bottom: 12px;
        }

        .hero p {
            font-size: 18px;
            max-width: 600px;
            margin: auto;
        }

        .button {
            display: inline-block;
            background: #111;
            color: white;
            text-decoration: none;
            padding: 13px 25px;
            margin-top: 20px;
            border-radius: 6px;
            font-weight: bold;
        }

        .button:hover {
            background: #444;
        }

        /* PRODUCTS */

        .products {
            padding: 40px 15px;
            text-align: center;
        }

        .products h2 {
            font-size: 28px;
            margin-bottom: 25px;
        }

        .product-container {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .product {
            background: white;
            width: 280px;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 3px 10px #ccc;
        }

        .shoe-icon {
            font-size: 60px;
            margin-bottom: 10px;
        }

        .product h3 {
            margin-bottom: 8px;
        }

        .price {
            font-size: 22px;
            font-weight: bold;
            margin-top: 10px;
        }

        /* ABOUT */

        .about {
            background: #111;
            color: white;
            text-align: center;
            padding: 40px 20px;
        }

        .about h2 {
            margin-bottom: 15px;
        }

        .about p {
            max-width: 650px;
            margin: auto;
        }

        /* CONTACT */

        .contact {
            text-align: center;
            background: white;
            padding: 40px 20px;
        }

        .contact h2 {
            margin-bottom: 15px;
        }

        .contact p {
            margin: 7px;
        }

        /* FOOTER */

        footer {
            background: #111;
            color: white;
            text-align: center;
            padding: 20px;
        }

        /* MOBILE */

        @media (max-width: 600px) {

            header h1 {
                font-size: 28px;
            }

            nav a {
                margin: 0 5px;
                font-size: 14px;
            }

            .hero h2 {
                font-size: 25px;
            }

        }

    </style>
</head>


<body>


<!-- HEADER -->

<header>

    <h1>DAVIDK COLLECTION</h1>

    <p>Quality Shoes at Affordable Prices</p>

</header>


<!-- NAVIGATION -->

<nav>

    <a href="#home">Home</a>

    <a href="#shoes">Shoes</a>

    <a href="#about">About</a>

    <a href="#contact">Contact</a>

</nav>


<!-- HERO SECTION -->

<section class="hero" id="home">

    <h2>Step Into Style</h2>

    <p>
        Welcome to Davidk Collection.
        We deal in quality and affordable shoes
        for different styles and occasions.
    </p>

    <a href="#shoes" class="button">
        SHOP NOW
    </a>

</section>


<!-- SHOES SECTION -->

<section class="products" id="shoes">

    <h2>Our Shoes</h2>

    <div class="product-container">


        <div class="product">

            <div class="shoe-icon">👟</div>

            <h3>Casual Shoes</h3>

            <p>
                Comfortable shoes for everyday use.
            </p>

            <div class="price">
                From KSh 200
            </div>

        </div>


        <div class="product">

            <div class="shoe-icon">👞</div>

            <h3>Official Shoes</h3>

            <p>
                Smart footwear for work and special occasions.
            </p>

            <div class="price">
                From KSh 200
            </div>

        </div>


        <div class="product">

            <div class="shoe-icon">🥾</div>

            <h3>Boots</h3>

            <p>
                Strong and stylish footwear for different occasions.
            </p>

            <div class="price">
                From KSh 200
            </div>

        </div>


    </div>

</section>


<!-- ABOUT -->

<section class="about" id="about">

    <h2>About Davidk Collection</h2>

    <p>
        Davidk Collection is a shoe business based in Kitengela.
        Our goal is to provide customers with quality and
        affordable footwear while giving excellent customer service.
    </p>

</section>


<!-- CONTACT -->

<section class="contact" id="contact">

    <h2>Contact Davidk Collection</h2>

    <p>
        📍 Location: Kitengela, Kenya
    </p>

    <p>
        📧 Email: davidkmtinda@gmail.com
    </p>

    <p>
        👟 Quality Shoes | Affordable Prices
    </p>

</section>


<!-- FOOTER -->

<footer>

    <p>
        © 2026 Davidk Collection. All Rights Reserved.
    </p>

</footer>


</body>

</html>

                <h3>
                    Casual Shoes
                </h3>

                <div class="price">
                    KSh 200
                </div>

                <a
                    class="button"
                    href="https://wa.me/254796577665">

                    Order Now

                </a>

            </div>

        </div>

    </section>


    <!-- ABOUT -->

    <section class="section" id="about">

        <h2>
            About Davidk Collection
        </h2>

        <div class="about">

            <p>
                Welcome to
                <strong>Davidk Collection</strong>,
                your destination for quality and
                affordable shoes.
            </p>

            <br>

            <p>
                We offer different styles of shoes
                for men and women.
                Our goal is to provide stylish
                footwear at prices that everyone
                can afford.
            </p>

            <br>

            <p>
                Shop with Davidk Collection
                and step out in style.
            </p>

        </div>

    </section>


    <!-- CONTACT -->

    <section class="contact" id="contact">


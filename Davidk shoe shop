<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Davidk Collection | Quality Shoes</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f5f5f5;
            color: #222;
        }

        header {
            background: #111;
            color: white;
            padding: 20px;
            text-align: center;
        }

        header h1 {
            font-size: 30px;
        }

        header p {
            margin-top: 5px;
            color: #ddd;
        }

        nav {
            background: #222;
            text-align: center;
            padding: 12px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 10px;
            font-weight: bold;
        }

        nav a:hover {
            color: #ff9800;
        }

        .hero {
            background: linear-gradient(
                rgba(0,0,0,0.65),
                rgba(0,0,0,0.65)
            ),
            url("https://images.unsplash.com/photo-1542291026-7eec264c27ff")
            center/cover;

            color: white;
            text-align: center;
            padding: 90px 20px;
        }

        .hero h2 {
            font-size: 38px;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 18px;
            margin-bottom: 25px;
        }

        .button {
            display: inline-block;
            background: #ff9800;
            color: white;
            padding: 13px 25px;
            text-decoration: none;
            border-radius: 6px;
            font-weight: bold;
        }

        .button:hover {
            background: #e68900;
        }

        .section {
            padding: 45px 20px;
            max-width: 1100px;
            margin: auto;
        }

        .section h2 {
            text-align: center;
            margin-bottom: 30px;
            font-size: 28px;
        }

        .products {
            display: grid;
            grid-template-columns: repeat(
                auto-fit,
                minmax(220px, 1fr)
            );
            gap: 25px;
        }

        .product {
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 3px 10px rgba(0,0,0,0.12);
            text-align: center;
            padding-bottom: 20px;
        }

        .product img {
            width: 100%;
            height: 220px;
            object-fit: cover;
        }

        .product h3 {
            margin: 15px 0 8px;
        }

        .price {
            color: #e67e00;
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .about {
            background: white;
            padding: 30px;
            border-radius: 10px;
            line-height: 1.7;
            text-align: center;
        }

        .contact {
            background: #111;
            color: white;
            text-align: center;
            padding: 45px 20px;
        }

        .contact h2 {
            margin-bottom: 15px;
        }

        .contact p {
            margin: 8px 0;
        }

        footer {
            background: #000;
            color: #aaa;
            text-align: center;
            padding: 20px;
            font-size: 14px;
        }

        .whatsapp {
            display: inline-block;
            margin-top: 20px;
            background: #25D366;
            color: white;
            padding: 13px 25px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
        }

        @media (max-width: 600px) {

            header h1 {
                font-size: 25px;
            }

            .hero h2 {
                font-size: 30px;
            }

            nav a {
                display: inline-block;
                margin: 5px;
            }
        }
    </style>
</head>

<body>

    <!-- HEADER -->

    <header>
        <h1>DAVIDK COLLECTION</h1>

        <p>
            Quality Shoes at Affordable Prices
        </p>
    </header>


    <!-- NAVIGATION -->

    <nav>
        <a href="#home">Home</a>
        <a href="#shoes">Shoes</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
    </nav>


    <!-- HOME -->

